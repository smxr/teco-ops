// tecoKernel ????? 
__global__ void teco_slave_flash_attention_half(FlashAttentionArgs args) {
    int spe_num = args.spe_num;
    int tid = threadIdx;
    if (tid >= spe_num) {
        return;
    }
    int BM = 128;   // M block, 128 for ace
    int BN = 32;    // N block, 32 for ace; block_size
    int BK = 128;   // head_dim
    int token_size = args.size_per_head * sizeof(half);
    int * ldm_block_table = (int*)rt_spm_malloc(args.block_table_dim * sizeof(int));
    half * qbuf = (half*)rt_spm_malloc(BM * token_size);            // BM * BK
    half * kbuf = (half*)rt_spm_malloc(BN * token_size);            // BK * BN
    float * outc = (float*)rt_spm_malloc(BM * BN * sizeof(float));     // BM * BN
    int cur_q_seq_len = 0;
    for (int b = 0; b < args.batch_size; b++) {
        int q_seq_len = args.q_seq_lens[b], k_seq_len = args.kv_seq_lens[b];
        memcpy(ldm_block_table, args.block_table + b * args.block_table_dim, args.block_table_dim * sizeof(int));
        for (int i = 0; i < q_seq_len; i += BM) {
            for (int j = 0; j < k_seq_len; j += BN) {
                // load q
                int cur_BM = MIN(BM, q_seq_len % BM);
                int cur_BN = MIN(BN, k_seq_len % BN);
                half * src_q_ptr = (half *)args.q + (cur_q_seq_len + i) * (args.local_head_num * args.size_per_head) + tid * args.size_per_head;
                size_t q_src_stride = (args.local_head_num - 1) * token_size;
                memcpy_stride(qbuf, src_q_ptr, cur_BM * token_size, token_size, {0, q_src_stride});

                // load k
                int kv_group = tid / args.local_kv_head_num;           // GQA
                int cur_block = j / args.block_size;
                int block_id = ldm_block_table[cur_block];
                half * src_k_ptr = (half *)args.key_cache + block_id * args.local_kv_head_num * args.block_size * args.size_per_head
                                    + kv_group * args.block_size * args.size_per_head;
                memcpy(kbuf, src_k_ptr, cur_BN * token_size);

                // gemm
                // 只用ace的部分
                // gemm(qbuf, kbuf, outc, BM, BN, BK); // float
                

                // mask inplace // flaot
                // float online_softmax

            }
        }
        cur_q_seq_len += q_seq_len;
    }
    
}