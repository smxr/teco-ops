op_name: "flash_attention"
input {
  id: "blockTable"
  shape {
    dims: 1
    dims: 4
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT32
  ttype: TENSOR
  prev_value {
    value_i: 0
    value_i: 1
    value_i: 2
    value_i: 3
  }
}
input {
  id: "qData"
  shape {
    dims: 1
    dims: 32
    dims: 128
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data {
    seed: 10
    lower_bound: -1.0
    upper_bound: 1.0
    distribution: UNIFORM
  }
}
input {
  id: "kCache"
  shape {
    dims: 4
    dims: 8
    dims: 32
    dims: 128
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data {
    seed: 11
    lower_bound: -1.0
    upper_bound: 1.0
    distribution: UNIFORM
  }
}
input {
  id: "vCache"
  shape {
    dims: 4
    dims: 8
    dims: 32
    dims: 128
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  random_data {
    seed: 12
    lower_bound: -1.0
    upper_bound: 1.0
    distribution: UNIFORM
  }
}
input {
  id: "q_seq_lens"
  shape {
    dims: 1
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT32
  ttype: TENSOR
  prev_value {
    value_i: 1
  }
}
input {
  id: "kv_seq_lens"
  shape {
    dims: 1
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT32
  ttype: TENSOR
  prev_value {
    value_i: 128
  }
}
output {
  id: "oData"
  shape {
    dims: 1
    dims: 32
    dims: 128
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_HALF
  ttype: TENSOR
  reused: false
}
tecokernel_param {
  flash_attention_param {
    max_prefill_len: 1
    max_decode_len: 128
  }
}
test_param: {
    error_func: DIFF3_MAX
    error_threshold: 0.008
}